{
  "manifest_version": 3,
  "name": "AI Hours",
  "version": "0.5.0",
  "description": "Counts how long AI has worked for you. Records when AI works, never what was said.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "scripting"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://www.perplexity.ai/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "AI Hours",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "src/sse.js",
        "src/sites/chatgpt-network.js",
        "src/main-world.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "src/sites/chatgpt-page.js",
        "src/verify.js",
        "src/reconcile.js",
        "src/tracker.js",
        "src/total.js",
        "src/models.js",
        "src/breakdown-view.js",
        "src/overlay.js",
        "src/content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.perplexity.ai/*"
      ],
      "js": [
        "src/sse.js",
        "src/sites/perplexity-network.js",
        "src/main-world.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.perplexity.ai/*"
      ],
      "js": [
        "src/sites/perplexity-page.js",
        "src/verify.js",
        "src/reconcile.js",
        "src/tracker.js",
        "src/total.js",
        "src/models.js",
        "src/breakdown-view.js",
        "src/overlay.js",
        "src/content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "js": [
        "src/sse.js",
        "src/sites/claude-network.js",
        "src/main-world.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "js": [
        "src/sites/claude-page.js",
        "src/verify.js",
        "src/reconcile.js",
        "src/tracker.js",
        "src/total.js",
        "src/models.js",
        "src/breakdown-view.js",
        "src/overlay.js",
        "src/content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": [
        "src/sse.js",
        "src/sites/gemini-network.js",
        "src/main-world.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": [
        "src/sites/gemini-page.js",
        "src/verify.js",
        "src/reconcile.js",
        "src/tracker.js",
        "src/total.js",
        "src/models.js",
        "src/breakdown-view.js",
        "src/overlay.js",
        "src/content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
